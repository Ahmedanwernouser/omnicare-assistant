# Copy to .env and fill in ONE provider key.
#   cp .env.example .env

# groq | openai | anthropic | fake
LLM_PROVIDER=groq

# Leave blank to use the provider's default model.
LLM_MODEL=
LLM_TEMPERATURE=0.0

# Only the key matching LLM_PROVIDER is required.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional overrides ---
# RETRIEVAL_TOP_K=2
# MAX_TOOL_ITERATIONS=5
# MAX_MESSAGE_CHARS=2000
